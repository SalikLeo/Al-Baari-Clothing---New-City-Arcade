{
  "name": "al-baari-modest-attire",
  "version": "1.0.0",
  "description": "Al-Baari Modest Attire - EMA Belle by Al-Baari Management System",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^18.0.9",
    "jsbarcode": "^3.12.3"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.albaari.modestattire",
    "productName": "Al-Baari Modest Attire",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules/@electron/rebuild/**/*"
    ]
  }
}
