{
  "name": "al-baari-modest-attire",
  "version": "1.0.0",
  "description": "Al-Baari Modest Attire - Management System",
  "main": "main.js",
  "scripts": {
    "build": "node build.js",
    "build:win": "node build.js",
    "dist": "node build.js",
    "start": "electron .",
    "electron:dist": "electron-builder",
    "electron:build": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "jsbarcode": "^3.12.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8"
  },
  "electronBuilder": {
    "appId": "com.albaari.modestattire",
    "productName": "Al-Baari Modest Attire",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!dist",
      "!dist-electron",
      "!node_modules/@electron/rebuild/**/*"
    ]
  }
}
